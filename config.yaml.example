# Unified Quant Platform configuration example
# Copy to config.yaml and override only what differs from safe defaults.
# Runtime precedence: CLI > environment > config.yaml > safe defaults.
# Secrets should normally be injected through environment variables.

api:
  host: 0.0.0.0
  port: 8000
  allowed_origins:
    - http://localhost:3000
    - http://127.0.0.1:3000
  frontend_dist: ""  # empty = repository frontend/dist when present
  auth_disabled: false
  token: ""  # prefer PLATFORM_API_TOKEN
  token_subject: bootstrap-admin
  token_role: admin
  token_account_group: ""
  token_strategy_id: ""
  token_account_id: ""
  audit_log: ./logs/audit.log

# Data source configuration
data:
  provider: akshare
  cache_dir: ./cache
  adj: qfq
  start_date: "2023-01-01"
  end_date: "2024-12-31"
  providers:
    akshare:
      enabled: true
      rate_limit: 0.5
    yfinance:
      enabled: true
      rate_limit: 1.0
    tushare:
      enabled: false
      token: ""  # prefer TUSHARE_TOKEN
  level2:
    provider: stub
    enabled: false
    sdk_path: ""
    symbols: []
    depth: 10

backtest:
  initial_cash: 200000.0
  commission: 0.0003
  slippage: 0.001
  slippage_type: percentage
  min_trade_unit: 100
  allow_short: false

risk:
  enabled: true
  strict_mode: true
  max_position_pct: 0.30
  max_positions: 10
  daily_loss_limit_pct: 0.05
  max_drawdown_pct: 0.20
  max_order_value: 100000.0
  min_position_value: 1000.0
  price_deviation_limit: 0.05
  min_order_interval_sec: 0

# Platform orchestration. These values are consumed by the same PlatformSettings
# object as the API and deployment environment variables.
platform:
  job_store: ./cache/platform/jobs.json
  job_store_fallback: true
  job_max_workers: 2

execution:
  gateway: paper
  mode: vectorized
  enable_matching: true
  enable_slippage: true
  live_gateway:
    broker: futu
    account_id: ""
    testnet: true

strategy:
  name: default_strategy
  symbols:
    - 600519.SH
    - 000858.SZ
  params:
    period: 20
    threshold: 0.02

logging:
  level: INFO
  file: ./logs/quant.log
  format: "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
  json_format: false
  rotate_size: 10485760
  rotate_count: 5

database:
  path: ./cache/market_data.db
  duckdb_path: ./cache/market_data.duckdb
  backup_enabled: true
  backup_interval_hours: 24
  backup_retention_days: 30

monitoring:
  enabled: true
  health_check_interval: 60
  metrics_port: 9090
  alert_email: ""
  otlp_endpoint: ""
  alert_channels:
    webhook_url: ""
    webhook_platform: generic

performance:
  max_workers: 4
  cache_enabled: true
  cache_expire_days: 1

# OpenAI-compatible optional analysis configuration.
ai:
  api_key: ""  # prefer OPENAI_API_KEY
  base_url: "https://api.openai.com/v1"
  model: "gpt-4o-mini"
  timeout_seconds: 8.0

live_trading:
  enabled: false
  broker: "qmt"
  account_id: ""
  gateway_type: "qmt"
  gateway_provider: "self"
  qmt_provider: "self"
  vnpy_gateway: ""
  vnpy_setting: {}
  broker_options: {}
  sdk_path: ""
  sdk_log_path: ""
  auto_reconnect: true
  max_orders_per_second: 10.0

realtime_data:
  provider: "simulation"
  symbols: []
  fallback_providers: []
  interval_seconds: 3.0
  request_timeout_seconds: 5.0
  bar_intervals: [1, 5]
  level2_provider: "stub"

portfolio:
  strategies: []
  rebalance_interval_days: 21
  max_weight_per_strategy: 0.4
  min_weight_per_strategy: 0.05
  optimization_objective: "sharpe"
  capital_allocation:
    min_cash_buffer_pct: 0.05
    max_account_weight: 1.0
    max_strategy_weight: 0.5
